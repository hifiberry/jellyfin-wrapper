#!/bin/sh
set -e
#DEBHELPER#

ROOT="${DPKG_ROOT:-}"

# The D-Bus policy is generated by postinst, so dpkg does not know it.
# It stays on remove, like a conffile, and goes on purge.
if [ "$1" = "purge" ]; then
    rm -f "$ROOT/usr/share/dbus-1/system.d/hifiberry-jellyfin.conf"
    if [ -d "$ROOT/run/systemd/system" ]; then
        systemctl reload dbus >/dev/null 2>&1 || true
    fi
fi

exit 0
