#!/bin/sh
set -e
#DEBHELPER#

# Every path below is prefixed with $DPKG_ROOT, which dpkg sets (empty on a
# normal install). The tests run this script against a temporary root.
ROOT="${DPKG_ROOT:-}"
POLICY="$ROOT/usr/share/dbus-1/system.d/hifiberry-jellyfin.conf"
BUS_NAME="org.mpris.MediaPlayer2.com.github.iwalton3.jellyfin-mpv-shim"

# Only act on systems that are actually running (not an image build).
running() {
    [ -d "$ROOT/run/systemd/system" ]
}

HB_USER=""
if [ -f "$ROOT/etc/hifiberry.user" ]; then
    HB_USER=$(grep -vE '^[[:space:]]*#|^[[:space:]]*$' "$ROOT/etc/hifiberry.user" | head -1 | tr -d '[:space:]')
fi
if [ -n "$HB_USER" ] && ! getent passwd "$HB_USER" >/dev/null 2>&1; then
    echo "hifiberry-jellyfin: player user '$HB_USER' from /etc/hifiberry.user does not exist" >&2
    HB_USER=""
fi
if [ -z "$HB_USER" ]; then
    echo "hifiberry-jellyfin: no player user in /etc/hifiberry.user; the player will not show in the HiFiBerryOS UI until the package is reconfigured" >&2
fi

if [ -n "$HB_USER" ]; then
    # D-Bus policy for the player's MPRIS name on the SYSTEM bus.
    #
    # jellyfin.service points the shim's "session" bus at the system bus
    # (DBUS_SESSION_BUS_ADDRESS), because audiocontrol runs as its own user
    # and cannot reach the player user's session bus -- the arrangement
    # hifiberry-shairport uses for shairport-sync. The system bus only lets a
    # user own a name a policy grants, and its default policy denies method
    # calls to unknown destinations, so: the player user (/etc/hifiberry.user,
    # which differs between installations, hence generated rather than
    # shipped) may own the name, and anyone may send to it.
    mkdir -p "$(dirname "$POLICY")"
    cat > "$POLICY.tmp" <<EOF
<!DOCTYPE busconfig PUBLIC
 "-//freedesktop//DTD D-BUS Bus Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/dbus/1.0/busconfig.dtd">
<!-- Generated by the hifiberry-jellyfin postinst from /etc/hifiberry.user.
     Do not edit; regenerated on every (re)install, removed on purge. -->
<busconfig>
  <policy user="$HB_USER">
    <allow own="$BUS_NAME"/>
  </policy>
  <policy context="default">
    <allow send_destination="$BUS_NAME"/>
  </policy>
</busconfig>
EOF
    mv "$POLICY.tmp" "$POLICY"
    if running; then
        systemctl reload dbus >/dev/null 2>&1 || true
    fi

    # Video decoding and display need /dev/dri/renderD*, which belongs to
    # the render group. Group membership only reaches user managers started
    # afterwards, so a reboot is requested -- but only when the group really
    # had to be added: on a reinstall or upgrade, or for an audio-only device
    # whose user already has it, nothing changes and no reboot is asked for.
    # (Audio plays without it; the reboot only matters for video.)
    if getent group render >/dev/null 2>&1 && \
            ! id -nG "$HB_USER" | tr ' ' '\n' | grep -qx render; then
        usermod -aG render "$HB_USER"
        echo "hifiberry-jellyfin: added $HB_USER to the render group; video needs a reboot"
        if running; then
            touch "$ROOT/run/reboot-required" || true
        fi
    fi
fi

# NOTE: do NOT restart config-server here. When the WebUI installs an
# extension, config-server is the process running apt and holds the job the
# UI polls in memory; restarting it from a postinst kills that job and leaves
# the UI on "Configuring..." for ever. configurator reloads conf.d in place
# after every extension install (refresh_system_state() in
# configurator/extensions/postinstall.py), so it is also unnecessary. After a
# manual `apt install` from a shell, config-server keeps its cached conf.d
# until it is restarted by hand.

# Pick up /etc/nginx/hifiberry-api.d/jellyfin.nginx. Without this, a package
# installed onto a running system leaves /api/jellyfin/* unrouted until the
# next reboot.
if running && systemctl is-active --quiet nginx 2>/dev/null; then
    systemctl reload nginx >/dev/null 2>&1 || true
fi

# jellyfin-setup.service ships enabled (debian/rules), so its symlink is in
# place as soon as the package is unpacked. What a running system lacks is a
# user manager that has read the new unit and started it -- otherwise that
# only happens at the next login or boot, and until then the WebUI's
# Jellyfin card has nothing to talk to. restart rather than start, so an
# upgrade replaces a running old version. jellyfin.service (the player)
# ships disabled and is left alone. Best effort: no user manager yet (fresh
# image, user never logged in) is not an error.
if [ -n "$HB_USER" ] && running; then
    HB_UID=$(id -u "$HB_USER" 2>/dev/null || true)
    if [ -n "$HB_UID" ] && [ -d "$ROOT/run/user/$HB_UID" ]; then
        if ! systemd-run --uid "$HB_UID" --setenv XDG_RUNTIME_DIR="/run/user/$HB_UID" \
                --pipe --wait --quiet --collect \
                systemctl --user daemon-reload; then
            echo "hifiberry-jellyfin: could not reload the systemd --user instance for $HB_USER" >&2
        fi
        if ! systemd-run --uid "$HB_UID" --setenv XDG_RUNTIME_DIR="/run/user/$HB_UID" \
                --pipe --wait --quiet --collect \
                systemctl --user restart jellyfin-setup.service; then
            echo "hifiberry-jellyfin: could not start jellyfin-setup.service for $HB_USER; the WebUI's Jellyfin card will not work until the next login or reboot" >&2
        fi
    fi
fi

exit 0
