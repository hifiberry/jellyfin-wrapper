#!/usr/bin/python3
"""Sign-in and server discovery for the Jellyfin player, for the WebUI.

Run by jellyfin-setup.service as the HiFiBerryOS player user, listening on
127.0.0.1 only. nginx forwards /api/jellyfin/* here; config-server fetches
/servers for the server drop-down.

  GET    /status   what the player card shows: signed in or not, as whom
  GET    /servers  Jellyfin servers found on the LAN: [{id, name, address}]
  POST   /login    start Quick Connect: {code, expires_in}
  GET    /login    poll it: {state, code, error}
  DELETE /login    cancel it
  POST   /logout   revoke the token, drop the credentials

The server comes from ConfigDB, read on every request:
player.jellyfin.server_url (typed in by hand) wins over player.jellyfin.server
(picked from /servers).

Sign-in writes the credentials into the shim's users.json in the shape the
shim's own --quick-connect leaves there. One device is one signed-in user on
one server: a sign-in replaces every stored credential, because the shim
connects with all of them. Jellyfin binds the token to the
device id it was issued for, so every request to the server carries the
device_id from users.json; when there is no users.json yet, a new device id
is chosen and the file is created with the credential. Nothing is written
before the sign-in completes.

The shim keeps its users in memory and writes users.json itself, so the file
is only rewritten while the player is stopped: if jellyfin.service is
running it is stopped, users.json written, and the player started again.

The Quick Connect secret and the access token stay in this process and in
users.json (mode 0600). They are never logged, never returned, and never
put on a command line or into the environment.

Overrides, for tests: JELLYFIN_CONF_DIR, JELLYFIN_CONFIG_SERVER,
JELLYFIN_SYSTEMCTL_CMD, JELLYFIN_DISCOVERY_TARGET (host:port).
"""

import argparse
import contextlib
import datetime
import glob
import http.client
import http.server
import json
import logging
import os
import shlex
import socket
import subprocess
import sys
import tempfile
import threading
import time
import urllib.error
import urllib.parse
import urllib.request
import uuid

# Replaced with the package version at build time (debian/rules).
VERSION = "unreleased"

DEFAULT_PORT = 3551
CLIENT_NAME = "HiFiBerryOS"

SERVER_KEY = "player.jellyfin.server"
SERVER_URL_KEY = "player.jellyfin.server_url"
CONFIGDB_TIMEOUT = 2

SERVER_TIMEOUT = 5          # any request to the Jellyfin server
STATUS_INFO_TIMEOUT = 2     # the server name shown in /status
SERVER_INFO_TTL = 60        # how long that name is reused
SERVER_INFO_FAIL_TTL = 30   # how long an unreachable server is not asked again

LOGIN_EXPIRES_IN = 300

# Long enough for a normal shutdown of the shim.
PLAYER_STOP_TIMEOUT = 30

DISCOVERY_MESSAGE = b"who is JellyfinServer?"
DISCOVERY_TARGET = ("255.255.255.255", 7359)
DISCOVERY_LISTEN = 2.0
DISCOVERY_INTERVAL = 60
# A server that misses a scan or two (UDP is lossy) stays listed this long.
DISCOVERY_KEEP = 300
# A /servers request starts a new scan if the last one is older than this.
DISCOVERY_KICK_AFTER = 10

NO_SERVER = "Choose a server first."
NOT_REACHABLE = "Server not reachable"
QC_DISABLED = "Quick Connect is disabled on the server"

log = logging.getLogger("jellyfin-setup")


class HTTPFailure(Exception):
    """An answer for the WebUI: HTTP status and error message."""

    def __init__(self, status, message):
        super().__init__(message)
        self.status = status
        self.message = message


class Unreachable(Exception):
    pass


class Unresolvable(Unreachable):
    """The server's host name does not resolve on this device."""


def not_resolvable_message(server):
    host = urllib.parse.urlsplit(server).hostname or server
    return (f"This device can't find '{host}' on the network. "
            "Use the server's IP address instead.")


# --- device -----------------------------------------------------------------

def _first_line(cmd):
    try:
        out = subprocess.run(cmd, capture_output=True, text=True, timeout=5)
    except (OSError, subprocess.SubprocessError):
        return ""
    if out.returncode != 0:
        return ""
    lines = out.stdout.strip().splitlines()
    return lines[0].strip() if lines else ""


def player_name():
    """The device name; the same source start-jellyfin uses for player_name."""
    return (_first_line(["hostnamectl", "hostname", "--pretty"])
            or _first_line(["hostname"])
            or "HiFiBerry")


def _header_value(value):
    # Header values are latin-1 on the wire; Jellyfin URL-decodes them, which
    # is how its own clients send names outside ASCII.
    # ',' too: the header is a comma-separated list of key="value" pairs.
    return urllib.parse.quote(str(value), safe=" !#$&'()*+-./:;<=>?@[]^_`{|}~")


# --- server address ---------------------------------------------------------

def normalise_address(value):
    """A base URL like http://192.0.2.10:8096, or None if there is none.

    A bare host (typed in by hand) gets http:// and Jellyfin's port 8096.
    """
    if not isinstance(value, str):
        return None
    value = value.strip()
    if not value:
        return None
    bare = "://" not in value
    if bare:
        value = "http://" + value
    try:
        parts = urllib.parse.urlsplit(value)
        port = parts.port
    except ValueError:
        return None
    if parts.scheme not in ("http", "https") or not parts.hostname:
        return None
    netloc = parts.netloc
    if bare and port is None:
        netloc += ":8096"
    return urllib.parse.urlunsplit((parts.scheme, netloc, parts.path.rstrip("/"), "", ""))


# --- discovery --------------------------------------------------------------

def parse_discovery_reply(data):
    """{id, name, address} from one reply datagram, or None if it is not one."""
    try:
        reply = json.loads(data.decode("utf-8"))
    except (UnicodeDecodeError, ValueError):
        return None
    if not isinstance(reply, dict):
        return None
    address, server_id = reply.get("Address"), reply.get("Id")
    if not isinstance(address, str) or not address or not isinstance(server_id, str) or not server_id:
        return None
    name = reply.get("Name")
    if not isinstance(name, str) or not name:
        name = address
    return {"id": server_id, "name": name, "address": address.rstrip("/")}


def collect_servers(replies):
    """Parsed replies, one per server id, sorted by name."""
    found = {}
    for data in replies:
        entry = parse_discovery_reply(data)
        if entry and entry["id"] not in found:
            found[entry["id"]] = entry
    return sorted(found.values(), key=lambda e: (e["name"].casefold(), e["address"]))


def discover(target=DISCOVERY_TARGET, listen=DISCOVERY_LISTEN):
    """Broadcast Jellyfin's discovery probe and collect replies for `listen` s."""
    replies = []
    try:
        with socket.socket(socket.AF_INET, socket.SOCK_DGRAM) as sock:
            sock.setsockopt(socket.SOL_SOCKET, socket.SO_BROADCAST, 1)
            sock.sendto(DISCOVERY_MESSAGE, target)
            deadline = time.monotonic() + listen
            while True:
                remaining = deadline - time.monotonic()
                if remaining <= 0:
                    break
                sock.settimeout(remaining)
                try:
                    data, _ = sock.recvfrom(4096)
                except socket.timeout:
                    break
                replies.append(data)
    except OSError as exc:
        log.debug("discovery failed: %s", exc)
    return collect_servers(replies)


# --- users.json -------------------------------------------------------------

def write_atomic(path, text, mode=0o600):
    directory = os.path.dirname(path)
    fd, tmp = tempfile.mkstemp(dir=directory, prefix=".jellyfin-setup-")
    try:
        with os.fdopen(fd, "w") as f:
            f.write(text)
        os.chmod(tmp, mode)
        os.replace(tmp, path)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def fresh_user():
    return {
        "id": str(uuid.uuid4()),
        "name": "(default)",
        "device_id": str(uuid.uuid4()),
        "default": True,
        "pin_hash": None,
        "pin_salt": None,
        "require_pin_startup": False,
        "last_server": None,
        "auto_download": None,
        "credentials": [],
    }


def active_user(data):
    users = [u for u in data.get("users") or [] if isinstance(u, dict)]
    for user in users:
        if user.get("id") == data.get("active"):
            return user
    for user in users:
        if user.get("default"):
            return user
    return users[0] if users else None


# The shim writes this copy after every save of users.json and restores from
# it when users.json is missing or damaged.
BACKUP_SUFFIX = ".bak"


class UsersFile:
    def __init__(self, conf_dir):
        self.dir = conf_dir
        self.path = os.path.join(conf_dir, "users.json")
        self.backup = self.path + BACKUP_SUFFIX

    def load(self):
        """(data, state); state is 'ok', 'missing' or 'corrupt'."""
        try:
            with open(self.path) as f:
                data = json.load(f)
        except FileNotFoundError:
            return None, "missing"
        except (OSError, ValueError):
            return None, "corrupt"
        if not isinstance(data, dict) or not isinstance(data.get("users"), list):
            return None, "corrupt"
        return data, "ok"

    def save(self, data):
        """users.json, then its backup, the way the shim saves them.

        A backup left with older contents would be restored by the shim the
        next time users.json is damaged -- credentials removed here back.
        """
        os.makedirs(self.dir, mode=0o700, exist_ok=True)
        text = json.dumps(data, indent=4) + "\n"
        write_atomic(self.path, text)
        write_atomic(self.backup, text)

    def scrub_leftovers(self):
        """No copy of users.json may keep a token users.json no longer has.

        The backup is rewritten from users.json (or removed when users.json
        is unusable); everything else beside it -- the shim's .tmp and
        .unreadable-* set-asides, our .corrupt -- is removed.
        """
        data, state = self.load()
        for path in glob.glob(glob.escape(self.path) + ".*"):
            try:
                if path == self.backup and state == "ok":
                    write_atomic(path, json.dumps(data, indent=4) + "\n")
                else:
                    os.unlink(path)
            except OSError as exc:
                log.error("could not clean up %s: %s", os.path.basename(path), exc)

    def identity(self):
        """(user id, device id) the next sign-in will use. Writes nothing.

        Taken from users.json when it has them; otherwise new ones, which
        only reach the disk together with the credential.
        """
        data, state = self.load()
        user = active_user(data) if state == "ok" else None
        if user and user.get("id") and user.get("device_id"):
            return user["id"], user["device_id"]
        return (user or {}).get("id") or str(uuid.uuid4()), str(uuid.uuid4())

    def prepare(self, user_id, device_id):
        """(data, active user) to add a credential to, in memory only.

        None if users.json now carries a different device id than the one
        the sign-in was made with: the token would not fit it.
        """
        data, state = self.load()
        if state == "corrupt":
            os.replace(self.path, self.path + ".corrupt")
            log.warning("users.json was not readable; moved it to users.json.corrupt")
        if state != "ok":
            data = {"users": []}
        user = active_user(data)
        if user is None:
            user = dict(fresh_user(), id=user_id, device_id=device_id)
            data["users"].append(user)
            data["active"] = user["id"]
        if not user.get("device_id"):
            user["device_id"] = device_id
        if user["device_id"] != device_id:
            return None
        if not isinstance(user.get("credentials"), list):
            user["credentials"] = []
        data.setdefault("active", user["id"])
        # Key order as the shim writes it.
        data = {"active": data["active"], **{k: v for k, v in data.items() if k != "active"}}
        return data, active_user(data)


# --- talking to the Jellyfin server -----------------------------------------

class _NoRedirect(urllib.request.HTTPRedirectHandler):
    # A redirect would carry the Authorization header, token and all, to
    # wherever it points.
    def redirect_request(self, *args, **kwargs):
        return None


_opener = urllib.request.build_opener(_NoRedirect)


def auth_header(device_name, device_id, token=None):
    header = (f'MediaBrowser Client="{CLIENT_NAME}", Device="{_header_value(device_name)}", '
              f'DeviceId="{_header_value(device_id)}", Version="{_header_value(VERSION)}"')
    if token:
        header += f', Token="{token}"'
    return header


def server_request(base, method, path, *, authorization, body=None, timeout=SERVER_TIMEOUT):
    """(status, decoded JSON or None). Raises Unreachable on transport errors.

    Never puts the URL in an exception or a log line: the Quick Connect
    secret travels in a query string.
    """
    data = None
    headers = {"Authorization": authorization, "Accept": "application/json"}
    if body is not None:
        data = json.dumps(body).encode()
        headers["Content-Type"] = "application/json"
    elif method == "POST":
        data = b""
    request = urllib.request.Request(base + path, data=data, method=method, headers=headers)
    try:
        with _opener.open(request, timeout=timeout) as response:
            status, raw = response.status, response.read()
    except urllib.error.HTTPError as exc:
        status, raw = exc.code, b""
        exc.close()
    except (urllib.error.URLError, OSError, http.client.HTTPException, ValueError) as exc:
        if isinstance(getattr(exc, "reason", exc), socket.gaierror):
            raise Unresolvable("name not resolved") from None
        raise Unreachable(type(exc).__name__) from None
    try:
        payload = json.loads(raw) if raw else None
    except ValueError:
        payload = None
    return status, payload


# --- the service ------------------------------------------------------------

class Pending:
    def __init__(self, server, info, user_id, device_id, secret, code, started):
        self.server = server
        self.info = info
        self.user_id = user_id
        self.device_id = device_id
        self.secret = secret
        self.code = code
        self.started = started
        self.state = "waiting"
        self.error = None

    def finish(self, state, error=None):
        self.state = state
        self.error = error
        self.secret = None


class SetupService:
    def __init__(self, *, conf_dir, config_server, systemctl_cmd="systemctl --user",
                 device_name=player_name, clock=time.monotonic, scan=discover):
        self.users = UsersFile(conf_dir)
        self.config_server = config_server.rstrip("/")
        self.systemctl = shlex.split(systemctl_cmd)
        self.device_name = device_name
        self.clock = clock
        self.scan = scan
        self.server_timeout = SERVER_TIMEOUT

        self.lock = threading.Lock()          # users.json and the pending login
        self.pending = None
        self.info_cache = {}                  # address -> (time, info or None)

        self.servers_lock = threading.Lock()
        self.servers = {}                     # id -> (entry, last seen)
        self.last_scan = None
        self.wake = threading.Event()
        self.stopping = False
        self.scanner = None

    # -- discovery

    def start(self):
        self.scanner = threading.Thread(target=self._scan_loop, name="discovery", daemon=True)
        self.scanner.start()

    def stop(self):
        self.stopping = True
        self.wake.set()

    def _scan_loop(self):
        while not self.stopping:
            try:
                found = self.scan()
            except Exception:  # noqa: BLE001 - keep discovering
                log.exception("discovery scan failed")
                found = []
            now = time.monotonic()
            with self.servers_lock:
                for entry in found:
                    self.servers[entry["id"]] = (entry, now)
                for server_id, (_, seen) in list(self.servers.items()):
                    if now - seen > DISCOVERY_KEEP:
                        del self.servers[server_id]
                self.last_scan = now
            self.wake.wait(DISCOVERY_INTERVAL)
            self.wake.clear()

    def list_servers(self):
        with self.servers_lock:
            entries = [entry for entry, _ in self.servers.values()]
            last = self.last_scan
        if last is not None and time.monotonic() - last > DISCOVERY_KICK_AFTER:
            self.wake.set()
        return sorted(entries, key=lambda e: (e["name"].casefold(), e["address"]))

    # -- settings

    def _read_key(self, key):
        """The value, None when unset; raises Unreachable if ConfigDB is down."""
        url = f"{self.config_server}/api/v1/key/{key}"
        try:
            with urllib.request.urlopen(url, timeout=CONFIGDB_TIMEOUT) as response:
                payload = json.loads(response.read().decode())
        except urllib.error.HTTPError as exc:
            exc.close()
            if exc.code == 404:
                return None
            raise Unreachable("ConfigDB") from None
        except Exception:  # noqa: BLE001 - any transport failure
            raise Unreachable("ConfigDB") from None
        if not isinstance(payload, dict) or payload.get("status") != "success":
            return None
        return (payload.get("data") or {}).get("value")

    def server_address(self):
        """The chosen server's base URL; the hand-typed one wins."""
        try:
            return (normalise_address(self._read_key(SERVER_URL_KEY))
                    or normalise_address(self._read_key(SERVER_KEY)))
        except Unreachable:
            log.warning("ConfigDB did not answer; no server chosen")
            return None

    # -- systemd

    def _systemctl(self, *args, timeout=10):
        try:
            return subprocess.run([*self.systemctl, *args], capture_output=True,
                                  timeout=timeout).returncode
        except (OSError, subprocess.SubprocessError) as exc:
            log.warning("systemctl %s failed: %s", args[0], exc)
            return None

    def player_active(self):
        return self._systemctl("is-active", "--quiet", "jellyfin.service") == 0

    @contextlib.contextmanager
    def player_stopped(self):
        """Keep the player stopped while users.json is rewritten.

        The shim holds its users in memory and writes users.json itself, so
        a file changed under a running shim can be overwritten again: a new
        credential lost, a removed one back. Stop it, let the caller write,
        start it again if it was running.
        """
        was_active = self.player_active()
        stopped = True
        if was_active:
            log.info("stopping the player to update its sign-in")
            stopped = self._systemctl("stop", "jellyfin.service",
                                      timeout=PLAYER_STOP_TIMEOUT) == 0
            if not stopped:
                log.warning("the player did not stop; updating its sign-in anyway")
        try:
            yield
        finally:
            if was_active:
                # A player that would not stop gets a restart, so it at least
                # reads the new file.
                self._systemctl("start" if stopped else "restart", "jellyfin.service",
                                timeout=PLAYER_STOP_TIMEOUT)

    # -- server info

    def _auth(self, device_id, token=None):
        return auth_header(self.device_name(), device_id, token)

    def _server_info(self, base, device_id, timeout):
        status, info = server_request(base, "GET", "/System/Info/Public",
                                      authorization=self._auth(device_id), timeout=timeout)
        if status != 200 or not isinstance(info, dict) or not info.get("Id"):
            return None
        return info

    def _cached_server_info(self, base, device_id):
        now = self.clock()
        cached = self.info_cache.get(base)
        if cached:
            when, info = cached
            if now - when < (SERVER_INFO_TTL if info else SERVER_INFO_FAIL_TTL):
                return info
        try:
            info = self._server_info(base, device_id, min(STATUS_INFO_TIMEOUT, self.server_timeout))
        except Unreachable:
            info = None
        self.info_cache[base] = (now, info)
        return info

    # -- endpoints

    def status(self):
        server = self.server_address()
        data, state = self.users.load()
        creds, device_id = [], ""
        if state == "ok":
            user = active_user(data)
            if user:
                device_id = user.get("device_id") or ""
                creds = [c for c in user.get("credentials") or []
                         if isinstance(c, dict) and c.get("AccessToken")]

        # Signed in means: to the server that is chosen now. It matches by
        # address, or by server id when the same server is reached by
        # another address.
        credential = info = None
        if creds and server is not None:
            info = self._cached_server_info(server, device_id)
            for cred in creds:
                if (normalise_address(cred.get("address")) == server
                        or (info and cred.get("Id") == info.get("Id"))):
                    credential = cred
                    break

        # A credential for another server is not signed in, but the shim
        # still connects with it, so the card names it and offers Sign out.
        other = None
        if credential is None and creds:
            other = creds[0]

        account = server_name = None
        if credential:
            account = credential.get("username")
            server_name = (info or {}).get("ServerName") or credential.get("Name")
        elif other:
            account = other.get("username")
            server_name = other.get("Name") or other.get("address")

        return {
            "binary_installed": True,
            "version": VERSION,
            "build_date": None,
            "expires_on": None,
            "bridge_connected": True,
            "logged_in": credential is not None,
            "is_active": self.player_active(),
            "device_name": self.device_name(),
            "sign_in": {
                "method": "quick_connect",
                "account": account,
                "server_name": server_name,
                "ready": server is not None,
                "reason": None if server is not None else NO_SERVER,
                "other_server": other is not None,
            },
        }

    def start_login(self):
        server = self.server_address()
        if server is None:
            raise HTTPFailure(409, NO_SERVER)
        with self.lock:
            self.pending = None
            # Nothing is written yet: users.json changes only once, with the
            # credential, while the player is stopped.
            user_id, device_id = self.users.identity()
            try:
                info = self._server_info(server, device_id, self.server_timeout)
                if info is None:
                    log.warning("%r did not answer as a Jellyfin server", server)
                    raise HTTPFailure(502, NOT_REACHABLE)
                status, payload = server_request(server, "POST", "/QuickConnect/Initiate",
                                                 authorization=self._auth(device_id),
                                                 timeout=self.server_timeout)
            except Unresolvable:
                log.warning("%r does not resolve on this device", server)
                raise HTTPFailure(502, not_resolvable_message(server)) from None
            except Unreachable as exc:
                log.warning("%r not reachable (%s)", server, exc)
                raise HTTPFailure(502, NOT_REACHABLE) from None
            if status in (401, 403):
                raise HTTPFailure(409, QC_DISABLED)
            if (status != 200 or not isinstance(payload, dict)
                    or not payload.get("Secret") or not payload.get("Code")):
                log.warning("Quick Connect not started on %r (HTTP %s)", server, status)
                raise HTTPFailure(502, "The server did not start Quick Connect")
            self.pending = Pending(server, info, user_id, device_id, payload["Secret"],
                                   str(payload["Code"]), self.clock())
            log.info("Quick Connect started on %r", server)
            return {"code": self.pending.code, "expires_in": LOGIN_EXPIRES_IN}

    def poll_login(self):
        with self.lock:
            pending = self.pending
            if pending is None:
                return {"state": "idle", "code": None, "error": None}
            if pending.state == "waiting":
                self._advance(pending)
            return {"state": pending.state, "code": pending.code, "error": pending.error}

    def _advance(self, pending):
        if self.clock() - pending.started >= LOGIN_EXPIRES_IN:
            pending.finish("expired", "The code has expired.")
            return
        try:
            status, payload = server_request(
                pending.server, "GET",
                "/QuickConnect/Connect?" + urllib.parse.urlencode({"secret": pending.secret}),
                authorization=self._auth(pending.device_id), timeout=self.server_timeout)
        except Unreachable:
            return  # keep waiting; the next poll asks again
        if status == 404:
            pending.finish("expired", "The code has expired.")
            return
        if status != 200 or not isinstance(payload, dict) or payload.get("Authenticated") is not True:
            return
        self._complete(pending)

    def _complete(self, pending):
        try:
            status, payload = server_request(
                pending.server, "POST", "/Users/AuthenticateWithQuickConnect",
                authorization=self._auth(pending.device_id),
                body={"Secret": pending.secret}, timeout=self.server_timeout)
        except Unreachable:
            return  # approved but not collected yet; the next poll retries
        user_info = payload.get("User") if isinstance(payload, dict) else None
        token = payload.get("AccessToken") if isinstance(payload, dict) else None
        if status != 200 or not token or not isinstance(user_info, dict) or not user_info.get("Id"):
            log.warning("sign-in refused by %r (HTTP %s)", pending.server, status)
            pending.finish("failed", "The server refused the sign-in.")
            return

        with self.player_stopped():
            self._store(pending, user_info, token)
        if pending.state == "approved":
            self.info_cache.pop(pending.server, None)
            log.info("signed in as %r on %r", user_info.get("Name"), pending.server)

    def _store(self, pending, user_info, token):
        try:
            prepared = self.users.prepare(pending.user_id, pending.device_id)
            if prepared is None:
                # users.json was replaced while the code was pending; the
                # token belongs to a device id the shim does not use.
                pending.finish("failed", "Sign-in data changed meanwhile. Start again.")
                return
            data, user = prepared
            info = pending.info
            credential = {
                "address": pending.server,
                "Name": info.get("ServerName"),
                "Id": info.get("Id"),
                "Version": info.get("Version"),
                "DateLastAccessed": datetime.datetime.now(datetime.timezone.utc)
                .strftime("%Y-%m-%dT%H:%M:%SZ"),
                "UserId": user_info["Id"],
                "AccessToken": token,
                "Users": [{"Id": user_info["Id"], "IsSignedInOffline": True}],
                "uuid": str(uuid.uuid4()),
                "username": user_info.get("Name"),
            }
            # The only credential afterwards, in every profile: the shim
            # connects with all it has, and one left for a previous server
            # would keep the device a cast target there.
            for other in data["users"]:
                if isinstance(other, dict):
                    other["credentials"] = []
            user["credentials"] = [credential]
            self.users.save(data)
        except OSError as exc:
            log.error("could not write users.json: %s", exc)
            pending.finish("failed", "Could not save the sign-in data.")
            return
        pending.finish("approved")

    def cancel_login(self):
        with self.lock:
            self.pending = None
        return {"state": "idle", "code": None, "error": None}

    def logout(self):
        with self.lock:
            self.pending = None
            self.info_cache.clear()
            if not self._has_credentials():
                self.users.scrub_leftovers()
                return {"logged_in": False}
            with self.player_stopped():
                # Read again now that the shim has stopped and written its
                # last state.
                data, state = self.users.load()
                if state == "ok":
                    for user in data["users"]:
                        if not isinstance(user, dict):
                            continue
                        for cred in user.get("credentials") or []:
                            self._revoke(cred, user.get("device_id") or "")
                        user["credentials"] = []
                    try:
                        self.users.save(data)
                    except OSError as exc:
                        log.error("could not write users.json: %s", exc)
                        raise HTTPFailure(500, "Could not remove the sign-in data") from None
                self.users.scrub_leftovers()
            log.info("signed out")
        return {"logged_in": False}

    def _has_credentials(self):
        data, state = self.users.load()
        return state == "ok" and any(
            isinstance(user, dict) and user.get("credentials") for user in data["users"])

    def _revoke(self, cred, device_id):
        """Best effort: the token is dropped locally either way."""
        address = normalise_address(cred.get("address")) if isinstance(cred, dict) else None
        token = cred.get("AccessToken") if isinstance(cred, dict) else None
        if not address or not token:
            return
        try:
            status, _ = server_request(address, "POST", "/Sessions/Logout",
                                       authorization=self._auth(device_id, token),
                                       timeout=self.server_timeout)
            if status >= 300:
                log.info("%r did not revoke the token (HTTP %s)", address, status)
        except Unreachable:
            log.info("%r not reachable; token dropped locally only", address)


# --- HTTP -------------------------------------------------------------------

ROUTES = {
    "/status": {"GET": SetupService.status},
    "/servers": {"GET": SetupService.list_servers},
    "/login": {"POST": SetupService.start_login, "GET": SetupService.poll_login,
               "DELETE": SetupService.cancel_login},
    "/logout": {"POST": SetupService.logout},
}


def make_server(service, host, port):
    class Handler(http.server.BaseHTTPRequestHandler):
        server_version = "jellyfin-setup"
        sys_version = ""

        def _dispatch(self):
            length = int(self.headers.get("Content-Length") or 0)
            if length:
                self.rfile.read(min(length, 65536))
            path = urllib.parse.urlsplit(self.path).path.rstrip("/") or "/"
            methods = ROUTES.get(path)
            if methods is None:
                return self._send(404, {"error": "Not found"})
            handler = methods.get(self.command)
            if handler is None:
                return self._send(405, {"error": "Method not allowed"})
            try:
                return self._send(200, handler(service))
            except HTTPFailure as failure:
                return self._send(failure.status, {"error": failure.message})
            except Exception:  # noqa: BLE001 - answer, keep serving
                log.exception("%s %s failed", self.command, path)
                return self._send(500, {"error": "Internal error"})

        do_GET = do_POST = do_DELETE = do_PUT = do_PATCH = _dispatch

        def _send(self, status, payload):
            data = json.dumps(payload).encode()
            self.send_response(status)
            self.send_header("Content-Type", "application/json")
            self.send_header("Cache-Control", "no-store")
            self.send_header("Content-Length", str(len(data)))
            self.end_headers()
            self.wfile.write(data)

        def log_request(self, code="-", size="-"):
            path = urllib.parse.urlsplit(self.path).path
            log.debug("%s %r %s", self.command, path, code)

        def log_error(self, format, *args):
            log.warning(format, *args)

    httpd = http.server.ThreadingHTTPServer((host, port), Handler)
    httpd.daemon_threads = True
    return httpd


def _target(value):
    host, _, port = value.rpartition(":")
    return host, int(port)


def main(argv):
    parser = argparse.ArgumentParser(prog="jellyfin-setup")
    parser.add_argument("--port", type=int, default=DEFAULT_PORT)
    args = parser.parse_args(argv[1:])

    logging.basicConfig(stream=sys.stderr, level=logging.INFO,
                        format="jellyfin-setup: %(message)s")

    conf_dir = os.environ.get(
        "JELLYFIN_CONF_DIR",
        os.path.join(os.path.expanduser("~"), ".config", "jellyfin-mpv-shim"))
    target = os.environ.get("JELLYFIN_DISCOVERY_TARGET")
    target = _target(target) if target else DISCOVERY_TARGET

    service = SetupService(
        conf_dir=conf_dir,
        config_server=os.environ.get("JELLYFIN_CONFIG_SERVER", "http://127.0.0.1:1081"),
        systemctl_cmd=os.environ.get("JELLYFIN_SYSTEMCTL_CMD", "systemctl --user"),
        scan=lambda: discover(target=target),
    )
    httpd = make_server(service, "127.0.0.1", args.port)
    service.start()
    log.info("listening on 127.0.0.1:%d", args.port)
    try:
        httpd.serve_forever()
    except KeyboardInterrupt:
        pass
    finally:
        service.stop()
        httpd.server_close()
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
