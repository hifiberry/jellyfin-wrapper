[Unit]
Description=Jellyfin sign-in and server discovery for the WebUI
# No network ordering: a --user manager does not see network-online.target.
# None is needed either -- it listens on loopback, and discovery repeats
# every 60 s, so a scan made before the network is up is soon followed by one
# that finds the servers.

[Service]
Type=simple
# Listens on 127.0.0.1 only; nginx forwards /api/jellyfin/* here and
# config-server fetches /servers. It runs whether or not the player is
# enabled, because signing in comes before turning the player on.
ExecStart=/usr/bin/jellyfin-setup --port 3551
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
