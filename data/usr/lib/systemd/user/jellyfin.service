[Unit]
Description=Jellyfin cast target (jellyfin-mpv-shim)
# Only user units can be ordered against here: this runs in the player
# user's systemd --user manager, which does not see network-online.target or
# sound.target. Not waiting for the network is fine: start-jellyfin sets
# connect_retry_mins, so the shim keeps retrying a server it cannot reach yet.
After=pipewire.service
Wants=jellyfin-setup.service
# Five failed starts within two minutes leave the unit failed. Each attempt
# takes RestartSec plus the shim's start-up (several seconds on a Pi), so the
# default limit of five in 10 s would never be reached and a crashing player
# would be restarted for ever. Not signed in is not a failure: start-jellyfin
# then exits 0 without starting the shim and the unit is simply inactive.
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
# The shim publishes MPRIS on the "session" bus it finds here. Pointing that
# at the system bus is what lets audiocontrol, which runs as its own user,
# see the player -- the same arrangement as shairport-sync.
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/dbus/system_bus_socket
# Artwork goes under $XDG_CACHE_HOME/jellyfin-mpv-shim/mpris, which
# audiocontrol reads. start-jellyfin creates /tmp/jellyfin-mpv-shim and its
# .cache 0755 first; the player user's home is not readable to it.
Environment=XDG_CACHE_HOME=/tmp/jellyfin-mpv-shim/.cache
ExecStart=/usr/bin/start-jellyfin
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
